// Loops: while, for, break and continue, with switches, blocks and spawns inside.

component Tally
{
    int sum;
    int countdown;
    int evens;
    int pairs;
    int switched;
    int skipped;
    int picked;
    int forever;
    float half;
}

component Spark
{
    int index;
}

scene Main { }

event(Spawned) Setup(with Main)
{
    Spawn(Tally);
    for (var i = 0; i < 3; i++)
    {
        Spawn(Spark { index = i });
    }
}

// Runs its block for each number below n, in a loop of its own.
void Each(int n, Block content)
{
    for (var i = 0; i < n; i++)
    {
        content();
    }
}

int Forever()
{
    mut var n = 0;
    while (true)
    {
        n++;
        if (n == 5) return n;
    }
}

system Count(mut Tally t)
{
    for (var i = 1; i <= 10; i++) t.sum += i;

    mut var left = 3;
    while (left > 0)
    {
        t.countdown += 1;
        left--;
    }

    for (var i = 0; i < 10; i++)
    {
        if (i % 2 == 1) continue;
        t.evens += 1;
    }

    // Nested, with break leaving only the inner loop.
    for (var i = 0; i < 4; i++)
    {
        for (var j = 0; j < 4; j++)
        {
            if (j > i) break;
            t.pairs += 1;
        }
    }

    // break in a switch ends the switch; continue in one goes on with the loop.
    for (var i = 0; i < 5; i++)
    {
        switch (i)
        {
            case 1:
                continue;
            case 3:
                break;
            default:
                t.switched += 1;
                break;
        }
        t.skipped += 1;
    }

    // In a block: break and continue are the caller's, past Each's own loop.
    for (var round = 0; round < 10; round++)
    {
        Each(3)
        {
            if (round == 1) continue;
            if (round == 3) break;
            t.picked += 1;
        }
    }

    t.forever = Forever();

    mut var x = 1.0;
    x--;
    x++;
    t.half = x / 2;
}
