// Programs at the edges of what purrc generates. The test builds with -Werror,
// so any warning in the generated C fails it.

// C structs can't be empty; purrc has to handle that.
component Tag
{
}

singleton Settings
{
}

// Every field type, plus field names that are C keywords.
component Everything
{
    bool flag;
    int count;
    float amount;
    float3 offset;
    Entity other;
    int double;
    float static;
}

component Doomed
{
}

singleton Counter
{
    int ticks;
    int destroyed;
}

system Main(mut Counter counter)
{
    var first = Spawn(Tag);
    Spawn(Everything { flag = true, count = 1, amount = 0.5, offset = float3(1, 2, 3), other = first, double = 2 }, Tag);
    Spawn(Doomed);
    counter.ticks = 0;
}

// No parameters: runs once per tick.
system Nothing()
{
}

// Only singletons: runs once per tick.
system CountTicks(mut Counter counter, Settings settings)
{
    counter.ticks += 1;
}

// Only an Entity: runs for every entity.
system VisitAll(Entity e)
{
}

// Only filters.
system TaggedOnly(with Tag, without Doomed)
{
}

// Never runs: nothing spawns Tag and Doomed together.
system NeverRuns(with Tag, with Doomed)
{
}

// C keywords and a component name used as local names, and an early return.
system Keywords(mut Everything everything)
{
    var auto = everything.count;
    mut var register = auto * 2;
    register += 1;
    if (!everything.flag)
        return;
    everything.double = register;
    int Tag = 3;
    everything.count = Tag;
}

// Destroy with no Add or Remove anywhere in the program.
system Cleanup(Entity e, mut Counter counter, with Doomed)
{
    e.Destroy();
    counter.destroyed += 1;
}
