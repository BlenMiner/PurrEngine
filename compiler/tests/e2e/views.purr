// Views: run once per frame, read the world and record Draw calls.

singleton Palette
{
    Color background = Color(0.1, 0.2, 0.3);
}

component Body
{
    float2 position;
    float radius = 1;
}

component Tint
{
    Color color = Color.red;
}

component Hidden
{
    bool yes;
}

system Main()
{
    Spawn(Body { position = float2(1, 2) }, Tint);
    Spawn(Body { position = float2(3, 4), radius = 2 }, Tint { color = Color(0, 0.5, 1, 0.25) });
    Spawn(Body { position = float2(5, 6) }, Hidden);
}

// Once per frame: no entity parameters.
view Background(Palette palette, Time time)
{
    Draw.Clear(palette.background);
    Draw.Camera(float2(time.tick, 0), 10);
    Draw.Text("tick", float2(0, 0), 2, Color.white);
}

// Once per matching entity, skipping hidden ones.
view Bodies(Entity e, Body body, Tint tint, without Hidden)
{
    Draw.Circle(body.position, body.radius, tint.color);
    mut var solid = tint.color;
    solid.a = 1;
    Draw.WireRect(body.position, float2(body.radius * 2), solid);
}

view Hints(Body body, with Hidden)
{
    Draw.Line(body.position, body.position + float2(1, 0), Color.yellow);
    Draw.WireCircle(body.position, body.radius, Color(1, 1, 1));
    Draw.Rect(body.position, float2(2, 1), Color.gray);
    Draw.Text("say \"hi\"?", body.position, 1, Color.black);
}
