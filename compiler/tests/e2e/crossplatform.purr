// Cross-platform determinism: after many ticks, every platform must end up with
// bit-identical state. Exercises spawning, destroying, quaternions,
// transcendental functions and wrapping integer math.

component Body
{
    float3 position;
    float3 velocity;
    quaternion rotation = quaternion.identity;
    float phase;
    int counter;
}

singleton Spawner
{
    int spawned;
    int seed = 12345;
}

scene Main { }

event(Spawned) Setup(with Main, mut Spawner spawner)
{
    spawner.spawned = 0;
}

// One body per tick for the first 200 ticks, from a pseudo-random seed.
system SpawnBodies(mut Spawner spawner)
{
    if (spawner.spawned >= 200) return;
    spawner.seed = spawner.seed * 1103515245 + 12345; // Wraps, deterministically
    int r = (spawner.seed >> 8) & 0xFFFF;
    float f = float(r) / 65536;
    Spawn(Body { position = float3(f * 10 - 5, 20, f * 3),
                 velocity = float3(Math.Sin(f * 7), 0, Math.Cos(f * 5)),
                 phase = f,
                 counter = r });
    spawner.spawned += 1;
}

system Simulate(Time time, mut Body body)
{
    body.velocity.y -= 9.81 * time.dt;
    quaternion spin = quaternion.AxisAngle(Math.Normalize(float3(0.3, 1, 0.2)), body.phase * time.dt);
    body.rotation = Math.Normalize(Math.Mul(body.rotation, spin));
    body.position += Math.Rotate(body.rotation, body.velocity) * time.dt;
    if (body.position.y < 0)
    {
        body.position.y = -body.position.y;
        body.velocity.y = Math.Abs(body.velocity.y) * 0.8;
    }
    body.phase = Math.Frac(body.phase + Math.Pow(1.0001, float(body.counter & 255)) * 0.01)
               + Math.Atan2(body.velocity.x, 1) * 0.001;
    body.counter = (body.counter * 7 + (body.counter >> 3)) % 100000;
}

system Retire(Entity e, Body body)
{
    if (body.counter % 997 == 0)
        e.Destroy();
}
