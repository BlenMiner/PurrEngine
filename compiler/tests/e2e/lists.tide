// Lists: values that hold values, in components, singletons, locals and events.

struct Item
{
    string name;
    int count;
}

component Inventory
{
    List<Item> items;
    List<int> scores = [1, 2, 3];
    List<string> tags;
}

component Results
{
    int checks;
    int passed;
    int firstFailure;
}

singleton Seen
{
    List<Entity> entities;
}

event Found
{
    List<int> codes;
}

scene Main { }

event(Spawned) Setup(with Main)
{
    Spawn(Inventory { tags = ["new"] }, Results);
}

void Expect(mut Results t, bool ok)
{
    t.checks += 1;
    if (ok) t.passed += 1;
    else if (t.firstFailure == 0) t.firstFailure = t.checks;
}

int Sum(List<int> values)
{
    mut var total = 0;
    foreach (var v in values) total += v;
    return total;
}

List<int> Doubled(List<int> values)
{
    mut List<int> doubled = [];
    foreach (var v in values) doubled.Add(v * 2);
    return doubled;
}

system Use(mut Inventory inv, mut Results t, mut Seen seen)
{
    if (t.checks > 0) return; // Once

    // Defaults and literals
    Expect(t, inv.scores.Count == 3 && inv.scores[0] == 1 && inv.scores[2] == 3);
    Expect(t, inv.tags.Count == 1 && inv.tags[0] == "new");

    // Changing a component's list
    inv.scores.Add(4);
    inv.scores.Insert(0, 0);
    inv.scores.RemoveAt(2); // 0, 1, 3, 4
    Expect(t, Sum(inv.scores) == 8);
    inv.scores[1] += 10; // 0, 11, 3, 4
    Expect(t, inv.scores[1] == 11);
    Expect(t, inv.scores.Contains(3) && !inv.scores.Contains(99) && inv.scores.IndexOf(4) == 3);
    Expect(t, inv.scores.Remove(3) && !inv.scores.Remove(3)); // 0, 11, 4

    // Past the end, reads give zero and writes do nothing
    Expect(t, inv.scores[99] == 0 && inv.scores[-1] == 0);
    inv.scores[99] = 5;
    inv.scores.RemoveAt(-1);
    Expect(t, inv.scores.Count == 3);

    // A list taken out of a field is a copy
    mut var copy = inv.scores;
    copy.Add(100);
    copy[0] = 50;
    Expect(t, inv.scores.Count == 3 && inv.scores[0] == 0 && copy.Count == 4 && copy[0] == 50);

    // Lists in and out of functions
    var doubled = Doubled(inv.scores);
    Expect(t, doubled.Count == 3 && doubled[1] == 22);

    // Structs with text in them
    inv.items.Add(Item { name = "sword", count = 1 });
    inv.items.Add(Item { name = $"potion {2}", count = 2 });
    var potion = inv.items[1];
    Expect(t, potion.name == "potion 2" && potion.count == 2);
    mut var more = potion;
    more.count += 5;
    inv.items[1] = more;
    Expect(t, inv.items[1].count == 7 && inv.items[1].name == "potion 2");

    // Text in lists
    inv.tags.Add("shiny");
    inv.tags[0] = inv.tags[0] + "!";
    Expect(t, inv.tags[0] == "new!" && inv.tags.Contains("shiny") && inv.tags.IndexOf("shiny") == 1);

    // foreach, with continue and break
    mut var odd = 0;
    List<int> numbers = [1, 2, 3, 4, 5, 6];
    foreach (var n in numbers)
    {
        if (n % 2 == 0) continue;
        if (n > 4) break;
        odd += n;
    }
    Expect(t, odd == 4);

    // Entities, and a whole list assigned
    seen.entities.Add(this);
    Expect(t, seen.entities.Contains(this) && seen.entities.Count == 1);
    mut List<int> fresh = [7, 8];
    inv.scores = fresh;
    fresh.Add(9); // The field has its own copy
    Expect(t, inv.scores.Count == 2 && inv.scores[1] == 8 && fresh.Count == 3);

    // Events carry lists
    this.Send(Found { codes = inv.scores });
    inv.scores.Clear();
    Expect(t, inv.scores.Count == 0);
}

// Every tick after: new lists and text, the old ones released.
system Churn(mut Inventory inv, Results t)
{
    if (t.checks == 0) return;
    inv.tags = ["a", "b"];
    inv.items.Clear();
    inv.items.Add(Item { name = "x", count = 1 });
    inv.scores.Add(1);
    inv.scores.RemoveAt(0);
}

event(Found found) Heard(mut Results t)
{
    Expect(t, found.codes.Count == 2 && found.codes[0] == 7);
}
