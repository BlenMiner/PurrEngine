// Grids: cells at positions, in chunks only where something's there, read and
// changed by systems, and by parallel loops every cell at once.

enum Voxel : byte
{
    Air,
    Stone,
    Water = 200
}

struct Cell
{
    int id;
    float heat;
}

singleton Field
{
    Grid2<int> cells = Grid2(200, 100); // 4-byte cells: chunks of 64 by 64
    Grid2<int> lamps;                    // Open both ways
    Grid3<Voxel> blocks;                 // Open every way
}

component Canvas
{
    Grid2<Cell> pixels = Grid2(40, 30);
    int number;
}

struct Tally
{
    int checks;
    int passed;
    int firstFailure;
}

singleton Results
{
    Tally tally;
}

extern void c_visit(int x, int y);

scene Main { }

event(Spawned) Setup(with Main)
{
    Spawn(Canvas { number = 1 });
    Spawn(Canvas { number = 2, pixels = Grid2(10, 10) });
}

void Expect(mut Tally t, bool ok)
{
    t.checks += 1;
    if (ok) t.passed += 1;
    else if (t.firstFailure == 0) t.firstFailure = t.checks;
}

system Use(mut Field field, mut Results results, Time time)
{
    if (time.tick != 1) return; // Once, the tick after Setup

    // A size, and cells within it
    Expect(results.tally, field.cells.size.x == 200 && field.cells.size.y == 100 && field.lamps.size.x == 0 && field.lamps.size.y == 0);
    Expect(results.tally, field.cells[3, 4] == 0);
    field.cells[3, 4] = 7;
    field.cells[int2(199, 99)] = 9;
    Expect(results.tally, field.cells[3, 4] == 7 && field.cells[int2(199, 99)] == 9 && field.cells[4, 3] == 0);
    field.cells[3, 4] += 5;
    Expect(results.tally, field.cells[3, 4] == 12);

    // Past its size, reads give zero and writes do nothing
    field.cells[200, 0] = 1;
    field.cells[-1, 5] = 1;
    Expect(results.tally, field.cells[200, 0] == 0 && field.cells[-1, 5] == 0);

    // Open grids take any position, negative ones too
    field.lamps[-1000, 2000] = 3;
    field.lamps[64, 64] = 4;
    Expect(results.tally, field.lamps[-1000, 2000] == 3 && field.lamps[64, 64] == 4 && field.lamps[63, 63] == 0);
    field.blocks[1, -2, 3] = Voxel.Stone;
    field.blocks[100, 200, -300] = Voxel.Water;
    Expect(results.tally, field.blocks[1, -2, 3] == Voxel.Stone && field.blocks[100, 200, -300] == Voxel.Water);
    Expect(results.tally, field.blocks[0, 0, 0] == Voxel.Air && field.blocks.size.z == 0);

    // Cleared, it keeps its size; a new one starts empty with its own
    field.lamps.Clear();
    Expect(results.tally, field.lamps[-1000, 2000] == 0 && field.lamps[64, 64] == 0);
    field.lamps = Grid2(5, 5);
    field.lamps[6, 1] = 1;
    field.lamps[4, 4] = 2;
    Expect(results.tally, field.lamps.size.x == 5 && field.lamps.size.y == 5 && field.lamps[6, 1] == 0 && field.lamps[4, 4] == 2);

    // A column of ones to fall, across the chunk below them
    for (var y = 60; y < 70; y++) field.cells[10, y] = 1;
}

// Each canvas is its own grid.
system Paint(mut Canvas canvas, Time time)
{
    if (time.tick != 1) return;
    canvas.pixels[2, 3] = Cell { id = canvas.number, heat = 0.5 };
    canvas.pixels[39, 29] = Cell { id = canvas.number * 10 };
}

system Look(Canvas canvas, mut Results results, Time time)
{
    if (time.tick != 2) return;
    var c = canvas.pixels[2, 3];
    Expect(results.tally, c.id == canvas.number && c.heat == 0.5);
    // The second canvas is 10 by 10, so its far corner was never set
    Expect(results.tally, canvas.pixels[39, 29].id == (canvas.number == 1 ? 10 : 0));
}

// Ones fall a cell a tick, onto the floor at y = 0, never through each other:
// in blocks of a cell and the one above it, from even rows one tick and odd
// ones the next.
system Fall(mut Field field, Time time)
{
    parallel (var at in field.cells by int2(1, 2) offset int2(0, time.tick % 2))
    {
        if (field.cells[at + int2(0, 1)] != 1 || field.cells[at] != 0) continue;
        field.cells[at] = 1;
        field.cells[at + int2(0, 1)] = 0;
    }
}

// Lamps light the cell next to them: every cell of the grid at once, each
// telling C it ran.
system Glow(mut Field field)
{
    parallel (var at in field.lamps)
    {
        c_visit(at.x, at.y);
        if (field.lamps[at] == 2) field.lamps[at] = 3;
    }
}

// An open grid's cells, in 3D: wherever it has chunks, all at once.
system Settle(mut Field field)
{
    foreach (var at in field.blocks)
    {
        if (field.blocks[at] == Voxel.Water) field.blocks[at] = Voxel.Stone;
    }
}
