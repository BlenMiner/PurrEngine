// A world that takes longer to send than the ticks a server keeps: a player
// joining it still catches up with the match. Its noise comes with the first
// tick, so a player who starts the match itself still lacks all of it.

singleton Archive
{
    List<int> noise; // Four megabytes that don't pack
    int ticks;
    int total;
}

input Controls
{
    int value;
}

scene Main { }

system Fill(mut Archive archive)
{
    if (archive.noise.Count > 0) return;
    for (var i = 0; i < 1_000_000; i++) archive.noise.Add(Math.Hash(i + 1));
}

event(PlayerJoined joined) Join()
{
    Spawn(Owner { player = joined.player });
}

system Count(mut Archive archive)
{
    archive.ticks += 1;
}

system Add(Controls input, mut Archive archive, with Owner)
{
    archive.total += input.value;
}
