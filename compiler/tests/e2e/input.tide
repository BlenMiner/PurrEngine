// Input: sampling devices on the client, and reading each player's input in systems.

component Transform
{
    float3 position;
}

component Jumps
{
    int count;
    int landings;
}

singleton Swap
{
    bool now;
}

input PlayerInput
{
    float2 move;
    bool jump;
    float speed = 1;

    Sample()
    {
        var keys = Devices.keyboard;
        if (keys.d.pressed) move.x += 1;
        if (keys.a.pressed) move.x -= 1;
        if (keys.w.pressed) move.y += 1;
        if (keys.s.pressed) move.y -= 1;
        move += Devices.gamepad.leftStick;
        jump = keys.space.pressed || Devices.gamepad.buttonSouth.pressed;
        if (Devices.mouse.left.down)
            speed = 2;
    }

    // Input from other machines can't be trusted; systems see it after this.
    Sanitize()
    {
        move.x = Math.Clamp(move.x, -1, 1);
        move.y = Math.Clamp(move.y, -1, 1);
        if (speed > 2) speed = 2;
    }
}

scene Main { }

event(Spawned) Setup(with Main)
{
    Spawn(Transform, Jumps, Owner { player = PlayerID(0) });
    Spawn(Transform, Jumps, Owner { player = PlayerID(1) });
    Spawn(Transform, Jumps, Owner); // Owned by no player: gets the server's input
    Spawn(Transform, Jumps);        // No Owner at all: the server's input too
}

singleton ServerView
{
    float moveX;
}

// Runs once per tick, so it reads the server's input.
system Watch(PlayerInput input, mut ServerView view)
{
    view.moveX = input.move.x;
}

system Move(PlayerInput input, Time time, mut Transform trs)
{
    trs.position += float3(input.move.x, 0, input.move.y) * input.speed * time.dt;
}

system Jump(PlayerInput input, mut Jumps jumps)
{
    if (input.jump.down) jumps.count += 1;
    if (input.jump.up) jumps.landings += 1;
}

// Hands players 0 and 1 each other's entity.
system SwapOwners(Swap swap, mut Owner owner)
{
    if (!swap.now) return;
    if (owner.player == PlayerID(0)) owner.player = PlayerID(1);
    else if (owner.player == PlayerID(1)) owner.player = PlayerID(0);
}
