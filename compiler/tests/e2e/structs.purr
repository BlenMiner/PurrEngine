// Structs: plain values in components, singletons, inputs and locals.

struct Range
{
    float lo;
    float hi = 1;
}

struct Stats
{
    bool alive = true; // Before a float: padding, which purrc writes out
    float health = 100;
    Range damage;      // Its defaults are Range's
    Range armor = Range { hi = 5 };
}

struct Aim
{
    [Clamp(-1, 1)] float2 direction; // Applied to the input, which holds an Aim
    bool fire;                       // Padding after it
}

input PlayerInput
{
    Aim aim;
    [Min(0)] float speed;
}

component Unit
{
    Stats stats;
}

singleton Log
{
    Stats copy;
    float copy_health;
    float2 aim;
    float speed;
    int fired;
    int fire_downs;
}

system Main()
{
    Spawn(Unit);
    Spawn(Unit { stats = Stats { health = 50, damage = Range { lo = 2, hi = 3 } } });
}

system Hurt(mut Unit unit)
{
    unit.stats.health -= unit.stats.damage.hi;
    if (unit.stats.health <= 50) unit.stats.alive = false;
}

// A struct is copied: changing the copy leaves the component alone.
system Copy(Unit unit, mut Log log)
{
    mut var copy = unit.stats;
    copy.health = 0;
    log.copy = copy;
    log.copy_health = unit.stats.health;
}

system Read(PlayerInput input, mut Log log)
{
    log.aim = input.aim.direction;
    log.speed = input.speed;
    if (input.aim.fire) log.fired += 1;
    if (input.aim.fire.down) log.fire_downs += 1; // .down works inside structs too
}
