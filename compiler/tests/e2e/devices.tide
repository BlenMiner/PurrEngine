// Systems take Devices: the devices of the player who owns the entity, or the
// server's. The input sends what match code reads of them, and nothing else.
// There's no input declaration: the game gets one that only sends devices.

component Walker
{
    float2 position;
    int jumps;
    float throttle;
    bool connected;
    int taps;
    float2 swipe;
    int fingers;
    int slots;
}

scene Main { }

event(Spawned) Setup(with Main)
{
    Spawn(Walker, Owner { player = PlayerID(0) });
    Spawn(Walker, Owner { player = PlayerID(1) });
    Spawn(Walker); // No owner: the server's devices
}

// A part of the devices, passed on: what the function reads is sent.
float2 Stick(Gamepad pad)
{
    return pad.leftStick;
}

bool Jumped(Devices devices)
{
    return devices.keyboard.space.down || devices.gamepad.buttonSouth.down;
}

system Walk(Devices devices, Time time, mut Walker w)
{
    w.position += Stick(devices.gamepad) * time.dt;
    if (Jumped(devices)) w.jumps += 1;
    w.throttle = devices.gamepad.rightTrigger;
    w.connected = devices.gamepad.connected;
}

// A touch passed on: what the function reads is sent, of every touch it could be.
bool Tapped(Touch touch)
{
    return touch.press.down;
}

// Fingers: the first slot's movement, and every slot's press. Their positions
// are in this machine's window, so they're never sent.
system Swipe(Devices devices, mut Walker w)
{
    if (Tapped(devices.touchscreen.primaryTouch)) w.taps += 1;
    w.swipe += devices.touchscreen.touches[0].delta;
    mut var fingers = 0;
    foreach (var touch in devices.touchscreen.touches)
    {
        if (touch.press.pressed) fingers += 1;
    }
    w.fingers = fingers;
    w.slots = devices.touchscreen.touches.count;
}
