// A match over a bad network: players join, move and leave, and every machine
// must keep the server's world exactly.

component Mover
{
    float2 position;
    int jumps;
}

component Ball
{
    float2 position;
    float2 velocity;
}

input Controls
{
    float2 move;
    bool jump;
}

singleton Players
{
    int joined;
    int left;
}

scene Main { }

scene Arena
{
    int size = 10;
}

event(Spawned) Setup(with Main)
{
    Spawn(Ball { velocity = float2(1, 0.5) });
}

event(Spawned) Fill(Arena arena)
{
    Spawn(Ball { velocity = float2(arena.size, 0) });
}

event(PlayerJoined joined) Join(mut Players players)
{
    players.joined += 1;
    Spawn(Mover { position = float2(players.joined, 0) }, Owner { player = joined.player });
}

event(PlayerLeft left) Leave(mut Players players)
{
    players.left += 1;
}

system Move(Controls input, Time time, mut Mover mover, with Owner)
{
    mover.position += input.move * time.dt * 5;
    if (input.jump.down) mover.jumps += 1;
}

system Roll(Time time, mut Ball ball)
{
    ball.position += ball.velocity * time.dt;
    if (Math.Abs(ball.position.x) > 20) ball.velocity.x = -ball.velocity.x;
    if (Math.Abs(ball.position.y) > 20) ball.velocity.y = -ball.velocity.y;
}

// Starting a match from local code, and joining one.
local singleton Menu
{
    bool play;
    bool host;  // Start and Open, in one frame
    bool close;
    bool kick;
    bool copy;
    bool join;
    bool connect;
    bool inRoom; // Session.room, as the view read it
    int roomLength;
    string shown; // Session, as text
    string gone;  // The last Disconnected, as text
    string why;   // ...and its message
}

view Start(mut Menu menu, Session session)
{
    menu.inRoom = session.room == "K7QF2M";
    menu.roomLength = session.room.length;
    menu.shown = $"{session}";
    if (menu.join)
    {
        menu.join = false;
        Session.Join("k7qf2m");
    }
    if (menu.connect)
    {
        menu.connect = false;
        Session.Connect("192.168.1.5", 7000);
    }
    if (menu.host)
    {
        menu.host = false;
        Session.Open(); // For the match this machine is in now, which Start leaves
        Session.Start(Arena { size = 4 });
        Session.Open(7000);
    }
    if (menu.close)
    {
        menu.close = false;
        Session.Close();
    }
    if (menu.kick)
    {
        menu.kick = false;
        Session.Kick(PlayerID(1), "Be nice");
        Session.KickAll();
    }
    if (menu.copy)
    {
        menu.copy = false;
        Clipboard.Copy("first");
        Clipboard.Copy($"room {menu.roomLength} é");
    }
    if (!menu.play) return;
    menu.play = false;
    Session.Start(Arena { size = 3 });
}

local event(Disconnected gone) Gone(mut Menu menu)
{
    menu.gone = $"{gone}";
    menu.why = gone.message;
}
