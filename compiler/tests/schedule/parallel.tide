// Which systems can run at the same time: compared with parallel.txt.

component Position { float2 value; }
component Velocity { float2 value; }
component Player { int score; }
component Enemy { int hp; }
singleton Score { int total; }

scene Main { }

event(Spawned) Setup(with Main)
{
    Spawn(Position, Velocity, Player);
    Spawn(Position, Velocity, Enemy);
}

// Reads Velocity and writes Position.
system Move(mut Position pos, Velocity vel)
{
    pos.value += vel.value;
}

// Writes what Move reads, so it runs after it.
system Drag(mut Velocity vel)
{
    vel.value *= 0.9;
}

// Both write Position, but never on the same entities: they run alongside
// each other, after Move.
system PushPlayers(mut Position pos, with Player)
{
    pos.value.x += 1;
}

system PushEnemies(mut Position pos, with Enemy)
{
    pos.value.x -= 1;
}

// Shares nothing with the systems above.
system Tally(mut Score score, Player player)
{
    score.total += player.score;
}

// No data in common with Drag: only the attribute orders them.
[After(Drag)]
system Report(Enemy enemy)
{
    if (enemy.hp < 0) return;
}
