// expect: input fields have '.down' and '.up', not '.released'
component Jumps { int count; }
input PlayerInput
{
    bool jump;
    Sample(Devices devices) { jump = devices.keyboard.space.pressed; }
}
system Main() { Spawn(Jumps, Owner); }
system Land(PlayerInput input, mut Jumps jumps)
{
    if (input.jump.released) jumps.count += 1;
}
