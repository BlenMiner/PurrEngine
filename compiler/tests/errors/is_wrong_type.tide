// expect: 'Parse' gives int or fails with ParseError, so 'is' takes one of those, not float
enum ParseError { Empty }
int Parse(string text) fails ParseError
{
    if (text == "") fail ParseError.Empty;
    return 1;
}
singleton Score { float value; }
scene Main { }
system Count(mut Score score)
{
    if (Parse("1") is float value) score.value = value;
}
