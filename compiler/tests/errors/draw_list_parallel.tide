// expect: a parallel loop's steps run at once, so they can't draw
scene Main { }

extern void Paint(DrawList list);

local singleton Art
{
    Grid2<Color> cells = Grid2(4, 4);
}

view Show(mut Art art)
{
    parallel (var at in art.cells)
    {
        art.cells[at] = Color.red;
        Paint(Draw.list);
    }
}
