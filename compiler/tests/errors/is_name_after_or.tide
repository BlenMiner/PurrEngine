// expect: a name after 'is' only goes in an if's or a loop's condition, joined by '&&'
enum ParseError { Empty }
int Parse(string text) fails ParseError
{
    if (text == "") fail ParseError.Empty;
    return 1;
}
singleton Score { int value; }
scene Main { }
system Count(mut Score score)
{
    if (score.value > 0 || Parse("1") is int value) score.value = 1;
}
