{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PurrLang",
  "scopeName": "source.purrlang",
  "fileTypes": ["purr"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#namespaces" },
    { "include": "#attributes" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#literals" },
    { "include": "#builtins" },
    { "include": "#calls" },
    { "include": "#members" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.purrlang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.purrlang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "namespaces": {
      "patterns": [
        {
          "comment": "namespace Game.Combat; using Physics;",
          "begin": "^\\s*(namespace|using)\\b",
          "end": ";|$",
          "beginCaptures": {
            "1": { "name": "keyword.other.namespace.purrlang" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.terminator.purrlang" }
          },
          "patterns": [
            { "include": "#comments" },
            {
              "name": "entity.name.namespace.purrlang",
              "match": "[A-Za-z_][A-Za-z0-9_]*"
            },
            {
              "name": "punctuation.accessor.purrlang",
              "match": "\\."
            }
          ]
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "comment": "[Before(Physics.Gravity)], at the start of a line before a declaration",
          "begin": "^\\s*(\\[)",
          "end": "(\\])|$",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.attribute.begin.purrlang" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.attribute.end.purrlang" }
          },
          "patterns": [
            { "include": "#comments" },
            {
              "begin": "([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
              "end": "\\)|$",
              "beginCaptures": {
                "1": { "name": "entity.name.function.attribute.purrlang" },
                "2": { "name": "punctuation.parenthesis.begin.purrlang" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.parenthesis.end.purrlang" }
              },
              "patterns": [
                { "include": "#comments" },
                {
                  "name": "entity.name.function.purrlang",
                  "match": "[A-Za-z_][A-Za-z0-9_]*"
                },
                {
                  "name": "punctuation.accessor.purrlang",
                  "match": "\\."
                },
                {
                  "name": "punctuation.separator.comma.purrlang",
                  "match": ","
                }
              ]
            },
            {
              "name": "entity.name.function.attribute.purrlang",
              "match": "[A-Za-z_][A-Za-z0-9_]*"
            },
            {
              "name": "punctuation.separator.comma.purrlang",
              "match": ","
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "component Transform, singleton Time, struct Stats, input PlayerInput",
          "match": "\\b(component|singleton|struct|input)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.purrlang" },
            "2": { "name": "entity.name.type.purrlang" }
          }
        },
        {
          "comment": "system MovePlayer, view DrawBalls",
          "match": "\\b(system|view)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.purrlang" },
            "2": { "name": "entity.name.function.purrlang" }
          }
        },
        {
          "comment": "Money operator +(Money a, Money b), in a struct",
          "match": "\\b(operator)\\s*(==|!=|<=|>=|<<|>>|\\+|-|\\*|/|%|<|>|&|\\||\\^|!|~)(?=\\s*\\()",
          "captures": {
            "1": { "name": "keyword.other.operator.purrlang" },
            "2": { "name": "keyword.operator.purrlang" }
          }
        },
        {
          "comment": "Methods and functions: [mut] Type Name(, at the start of a line",
          "match": "^\\s*(?:(mut)\\s+)?(?!(?:return|if|else|var|mut|with|without|system|view|component|singleton|struct|input|namespace|using)\\b)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "storage.modifier.purrlang" },
            "2": { "patterns": [{ "include": "#builtins" }, { "include": "#types" }] },
            "3": { "name": "entity.name.function.purrlang" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.purrlang",
          "match": "\\b(if|else|return)\\b"
        },
        {
          "comment": "An input's Sample(Devices devices) and Sanitize()",
          "match": "^\\s*(Sample|Sanitize)(?=\\s*\\()",
          "captures": {
            "1": { "name": "keyword.other.purrlang" }
          }
        },
        {
          "comment": "Parameter and local modifiers",
          "name": "storage.modifier.purrlang",
          "match": "\\b(mut|with|without)\\b"
        },
        {
          "name": "storage.type.var.purrlang",
          "match": "\\bvar\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.boolean.purrlang",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "string.quoted.double.purrlang",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "name": "constant.character.escape.purrlang",
              "match": "\\\\[\"\\\\n]"
            }
          ]
        },
        {
          "name": "constant.numeric.integer.hexadecimal.purrlang",
          "match": "\\b0[xX][0-9A-Fa-f_]*[0-9A-Fa-f]\\b"
        },
        {
          "name": "constant.numeric.integer.binary.purrlang",
          "match": "\\b0[bB][01_]*[01]\\b"
        },
        {
          "name": "constant.numeric.float.purrlang",
          "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9][0-9_]*)?[fF]\\b|\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?\\b|\\b[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.purrlang",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "comment": "Built-in value types, and void for what a method or function returns",
          "name": "storage.type.primitive.purrlang",
          "match": "\\b(void|bool|int[234]?|float[234]?|float[234]x[234]|quaternion|Entity|PlayerID|Color)\\b"
        },
        {
          "comment": "Built-in singletons, components, records and function groups",
          "name": "support.class.purrlang",
          "match": "\\b(Time|Math|Draw|Owner|Devices)\\b"
        },
        {
          "comment": "Spawn(...)",
          "name": "support.function.purrlang",
          "match": "\\bSpawn(?=\\s*\\()"
        },
        {
          "comment": "e.Add(...), e.Remove(...), e.Destroy()",
          "match": "(\\.)\\s*(Add|Remove|Destroy)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.purrlang" },
            "2": { "name": "support.function.purrlang" }
          }
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.purrlang" }
          }
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "comment": "trs.position",
          "match": "(\\.)\\s*([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.purrlang" },
            "2": { "name": "variable.other.member.purrlang" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "comment": "Types are PascalCase by convention: Transform, Player",
          "name": "entity.name.type.purrlang",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.purrlang",
          "match": "<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^="
        },
        {
          "name": "keyword.operator.logical.purrlang",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.bitwise.shift.purrlang",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.comparison.purrlang",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.bitwise.purrlang",
          "match": "&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.assignment.purrlang",
          "match": "="
        },
        {
          "name": "keyword.operator.ternary.purrlang",
          "match": "\\?|:"
        },
        {
          "name": "keyword.operator.arithmetic.purrlang",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    }
  }
}
