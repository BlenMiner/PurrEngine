{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PurrLang",
  "scopeName": "source.purrlang",
  "fileTypes": ["purr"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#literals" },
    { "include": "#builtins" },
    { "include": "#calls" },
    { "include": "#members" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.purrlang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.purrlang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "component Transform, singleton Time",
          "match": "\\b(component|singleton)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.purrlang" },
            "2": { "name": "entity.name.type.purrlang" }
          }
        },
        {
          "comment": "system MovePlayer",
          "match": "\\b(system)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.purrlang" },
            "2": { "name": "entity.name.function.purrlang" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.purrlang",
          "match": "\\b(if|else|return)\\b"
        },
        {
          "comment": "Parameter and local modifiers",
          "name": "storage.modifier.purrlang",
          "match": "\\b(mut|with|without)\\b"
        },
        {
          "name": "storage.type.var.purrlang",
          "match": "\\bvar\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.boolean.purrlang",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.numeric.integer.hexadecimal.purrlang",
          "match": "\\b0[xX][0-9A-Fa-f_]*[0-9A-Fa-f]\\b"
        },
        {
          "name": "constant.numeric.integer.binary.purrlang",
          "match": "\\b0[bB][01_]*[01]\\b"
        },
        {
          "name": "constant.numeric.float.purrlang",
          "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9][0-9_]*)?[fF]\\b|\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?\\b|\\b[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.purrlang",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "comment": "Built-in value types",
          "name": "storage.type.primitive.purrlang",
          "match": "\\b(bool|int|float|float3|Entity)\\b"
        },
        {
          "comment": "Built-in singletons",
          "name": "support.class.purrlang",
          "match": "\\bTime\\b"
        },
        {
          "comment": "Spawn(...)",
          "name": "support.function.purrlang",
          "match": "\\bSpawn(?=\\s*\\()"
        },
        {
          "comment": "e.Add(...), e.Remove(...), e.Destroy()",
          "match": "(\\.)\\s*(Add|Remove|Destroy)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.purrlang" },
            "2": { "name": "support.function.purrlang" }
          }
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.purrlang" }
          }
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "comment": "trs.position",
          "match": "(\\.)\\s*([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.purrlang" },
            "2": { "name": "variable.other.member.purrlang" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "comment": "Types are PascalCase by convention: Transform, Player",
          "name": "entity.name.type.purrlang",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.purrlang",
          "match": "\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.comparison.purrlang",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.purrlang",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.purrlang",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.purrlang",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    }
  }
}
