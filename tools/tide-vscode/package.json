{
  "name": "tide",
  "displayName": "Tide",
  "description": "The Tide language: errors as you type, completion, go to definition, rename, formatting and more, from tidels",
  "version": "0.0.0",
  "publisher": "tide-engine",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlenMiner/tide-engine"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:tide"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, nothing from the workspace runs: the language server is the tidels that comes with tide (or one your user settings name outside the workspace), never the workspace's build/tools/tidels or one its settings name, and games don't run, as running one runs its code.",
      "restrictedConfigurations": [
        "tide.server.path",
        "tide.path"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "tide",
        "aliases": [
          "Tide",
          "tide"
        ],
        "extensions": [
          ".tide"
        ],
        "icon": {
          "light": "./icons/tide.svg",
          "dark": "./icons/tide.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tide",
        "scopeName": "source.tide",
        "path": "./syntaxes/tide.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Tide",
      "properties": {
        "tide.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The language server to run. Empty: the open folder's `build/tools/tidels` when it's Tide itself, else `tidels` from `PATH`, or from where tide is installed. `~` is your home folder; `${workspaceFolder}` and relative paths are the folder whose settings set it, or for user and workspace settings, the first open folder; `${workspaceFolder:name}` is the open folder of that name. In Restricted Mode, only your user settings count, and never for a server in the workspace."
        },
        "tide.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The `tide` that **Tide: Run**, **Tide: Run on the Web** and **Tide: Run on Android** run. Empty: `tide` from `PATH`, or from where tide is installed. `~` is your home folder; `${workspaceFolder}` and relative paths are the folder whose settings set it, or for user and workspace settings, the game's folder; `${workspaceFolder:name}` is the open folder of that name."
        },
        "tide.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "enumDescriptions": [
            "Nothing",
            "The name of each message",
            "Each message, whole"
          ],
          "default": "off",
          "scope": "window",
          "markdownDescription": "Shows what VS Code and the language server say to each other in the **Tide Trace** output, for reporting a problem with the server."
        }
      }
    },
    "commands": [
      {
        "command": "tide.restartServer",
        "title": "Restart Language Server",
        "category": "Tide"
      },
      {
        "command": "tide.run",
        "title": "Run",
        "category": "Tide",
        "icon": "$(play)"
      },
      {
        "command": "tide.runWeb",
        "title": "Run on the Web",
        "category": "Tide",
        "icon": "$(globe)"
      },
      {
        "command": "tide.runAndroid",
        "title": "Run on Android",
        "category": "Tide",
        "icon": "$(device-mobile)"
      },
      {
        "command": "tide.openDevTools",
        "title": "Game Developer Tools",
        "category": "Tide",
        "icon": "$(tools)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "tide.run",
          "when": "resourceLangId == tide && isWorkspaceTrusted"
        },
        {
          "command": "tide.runWeb",
          "when": "resourceLangId == tide && isWorkspaceTrusted"
        },
        {
          "command": "tide.runAndroid",
          "when": "resourceLangId == tide && isWorkspaceTrusted"
        }
      ],
      "editor/title": [
        {
          "command": "tide.openDevTools",
          "when": "activeWebviewPanelId == 'simpleBrowser.view' && tide.gamePage",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "tide.openDevTools",
          "when": "tide.gamePage"
        }
      ]
    },
    "configurationDefaults": {
      "[tide]": {
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.js --bundle --platform=node --format=cjs --external:vscode --minify --outfile=out/extension.js"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
