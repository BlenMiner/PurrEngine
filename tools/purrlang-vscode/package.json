{
  "name": "purrlang",
  "displayName": "PurrLang",
  "description": "PurrLang for PurrEngine: errors as you type, completion, go to definition, rename, formatting and more, from purrls",
  "version": "0.0.0",
  "publisher": "purrengine",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlenMiner/PurrEngine"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:purrlang"
  ],
  "contributes": {
    "languages": [
      {
        "id": "purrlang",
        "aliases": [
          "PurrLang",
          "purr"
        ],
        "extensions": [
          ".purr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "purrlang",
        "scopeName": "source.purrlang",
        "path": "./syntaxes/purrlang.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "PurrLang",
      "properties": {
        "purrlang.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The language server to run. Empty: the open folder's `build/tools/purrls` when it's PurrEngine itself, else `purrls` from `PATH`, or from where purr is installed. `${workspaceFolder}` is the open folder."
        }
      }
    },
    "commands": [
      {
        "command": "purrlang.restartServer",
        "title": "Restart Language Server",
        "category": "PurrLang"
      }
    ],
    "configurationDefaults": {
      "[purrlang]": {
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.js --bundle --platform=node --format=cjs --external:vscode --minify --outfile=out/extension.js"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
