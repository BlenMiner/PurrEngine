{
  "name": "tide-syntax",
  "displayName": "Tide Syntax",
  "description": "Syntax highlighting for Tide (.tide), without the language server: the Tide extension (tide-engine.tide) has both",
  "version": "0.1.0",
  "publisher": "tide-engine",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tide",
        "aliases": [
          "Tide",
          "tide"
        ],
        "extensions": [
          ".tide"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tide",
        "scopeName": "source.tide",
        "path": "./syntaxes/tide.tmLanguage.json"
      }
    ]
  }
}
