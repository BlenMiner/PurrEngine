{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tide",
  "scopeName": "source.tide",
  "fileTypes": ["tide"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#namespaces" },
    { "include": "#attributes" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#interpolated" },
    { "include": "#literals" },
    { "include": "#builtins" },
    { "include": "#calls" },
    { "include": "#members" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tide",
          "match": "//.*$"
        },
        {
          "name": "comment.block.tide",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "namespaces": {
      "patterns": [
        {
          "comment": "namespace Game.Combat; using Physics;",
          "begin": "^\\s*(namespace|using)\\b",
          "end": ";|$",
          "beginCaptures": {
            "1": { "name": "keyword.other.namespace.tide" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.terminator.tide" }
          },
          "patterns": [
            { "include": "#comments" },
            {
              "name": "entity.name.namespace.tide",
              "match": "[A-Za-z_][A-Za-z0-9_]*"
            },
            {
              "name": "punctuation.accessor.tide",
              "match": "\\."
            }
          ]
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "comment": "[Before(Physics.Gravity)], at the start of a line before a declaration",
          "begin": "^\\s*(\\[)",
          "end": "(\\])|$",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.attribute.begin.tide" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.attribute.end.tide" }
          },
          "patterns": [
            { "include": "#comments" },
            {
              "begin": "([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
              "end": "\\)|$",
              "beginCaptures": {
                "1": { "name": "entity.name.function.attribute.tide" },
                "2": { "name": "punctuation.parenthesis.begin.tide" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.parenthesis.end.tide" }
              },
              "patterns": [
                { "include": "#comments" },
                { "include": "#literals" },
                {
                  "name": "entity.name.function.tide",
                  "match": "[A-Za-z_][A-Za-z0-9_]*"
                },
                {
                  "name": "punctuation.accessor.tide",
                  "match": "\\."
                },
                {
                  "name": "punctuation.separator.comma.tide",
                  "match": ","
                }
              ]
            },
            {
              "name": "entity.name.function.attribute.tide",
              "match": "[A-Za-z_][A-Za-z0-9_]*"
            },
            {
              "name": "punctuation.separator.comma.tide",
              "match": ","
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "local before a declaration: it belongs to this machine, not the match",
          "match": "^\\s*(local)(?=\\s+(?:component|singleton|event|scene|struct|input|system|view)\\b)",
          "captures": {
            "1": { "name": "storage.modifier.tide" }
          }
        },
        {
          "comment": "component Transform, singleton Time, struct Stats, input PlayerInput, event Hit, enum Page, scene Arena",
          "match": "\\b(component|singleton|struct|input|event|enum|scene)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.tide" },
            "2": { "name": "entity.name.type.tide" }
          }
        },
        {
          "comment": "event(Hit hit) TakeHit: an event handler, with the event it handles",
          "match": "\\b(event)\\s*(\\()\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?\\s*(\\))\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.tide" },
            "2": { "name": "punctuation.parenthesis.open.tide" },
            "3": { "patterns": [{ "include": "#types" }] },
            "4": { "name": "variable.parameter.tide" },
            "5": { "name": "punctuation.parenthesis.close.tide" },
            "6": { "name": "entity.name.function.tide" }
          }
        },
        {
          "comment": "system MovePlayer, view DrawBalls",
          "match": "\\b(system|view)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.tide" },
            "2": { "name": "entity.name.function.tide" }
          }
        },
        {
          "comment": "Money operator +(Money a, Money b), in a struct",
          "match": "\\b(operator)\\s*(==|!=|<=|>=|<<|>>|\\+|-|\\*|/|%|<|>|&|\\||\\^|!|~)(?=\\s*\\()",
          "captures": {
            "1": { "name": "keyword.other.operator.tide" },
            "2": { "name": "keyword.operator.tide" }
          }
        },
        {
          "comment": "extern float Noise(: a function written in C",
          "match": "^\\s*(extern)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "storage.modifier.tide" },
            "2": { "patterns": [{ "include": "#builtins" }, { "include": "#types" }] },
            "3": { "name": "entity.name.function.tide" }
          }
        },
        {
          "comment": "settings { ... }: the engine's settings for the game",
          "match": "^\\s*(settings)(?=\\s*(?:\\{|$))",
          "captures": {
            "1": { "name": "storage.type.tide" }
          }
        },
        {
          "comment": "const int MAX_HEALTH = ...: a constant",
          "match": "^\\s*(const)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*=)",
          "captures": {
            "1": { "name": "storage.modifier.tide" },
            "2": { "patterns": [{ "include": "#builtins" }, { "include": "#types" }] },
            "3": { "name": "variable.other.constant.tide" }
          }
        },
        {
          "comment": "Methods and functions: [mut] Type Name(, at the start of a line",
          "match": "^\\s*(?:(mut)\\s+)?(?!(?:return|if|else|var|mut|with|without|system|view|component|singleton|struct|input|event|enum|scene|local|switch|case|default|break|while|for|foreach|in|continue|namespace|using|extern|const)\\b)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "storage.modifier.tide" },
            "2": { "patterns": [{ "include": "#builtins" }, { "include": "#types" }] },
            "3": { "name": "entity.name.function.tide" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tide",
          "match": "\\b(if|else|return|switch|case|default|break|while|for|foreach|in|continue)\\b"
        },
        {
          "comment": "An input's Sample() and Sanitize()",
          "match": "^\\s*(Sample|Sanitize)(?=\\s*\\()",
          "captures": {
            "1": { "name": "keyword.other.tide" }
          }
        },
        {
          "comment": "Parameter and local modifiers",
          "name": "storage.modifier.tide",
          "match": "\\b(mut|with|without)\\b"
        },
        {
          "comment": "The entity the code runs for",
          "name": "variable.language.this.tide",
          "match": "\\bthis\\b"
        },
        {
          "name": "storage.type.var.tide",
          "match": "\\bvar\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.boolean.tide",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "string.quoted.double.tide",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "name": "constant.character.escape.tide",
              "match": "\\\\[\"\\\\n]"
            }
          ]
        },
        {
          "name": "constant.numeric.integer.hexadecimal.tide",
          "match": "\\b0[xX][0-9A-Fa-f_]*[0-9A-Fa-f]\\b"
        },
        {
          "name": "constant.numeric.integer.binary.tide",
          "match": "\\b0[bB][01_]*[01]\\b"
        },
        {
          "name": "constant.numeric.float.tide",
          "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9][0-9_]*)?[fF]\\b|\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?\\b|\\b[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.tide",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "interpolated": {
      "comment": "$\"score {score:D3}\": text with values in it",
      "name": "string.quoted.double.interpolated.tide",
      "begin": "\\$\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.tide",
          "match": "\\\\[\"\\\\n]|\\{\\{|\\}\\}"
        },
        {
          "name": "meta.interpolation.tide",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.tide" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.tide" } },
          "contentName": "source.tide",
          "patterns": [
            {
              "comment": "The value's format: {x:F2}",
              "name": "constant.other.format.tide",
              "match": ":[A-Za-z][0-9]*(?=\\})"
            },
            { "include": "$self" }
          ]
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "comment": "Built-in value types, void for what a method or function returns, text and Blocks",
          "name": "storage.type.primitive.tide",
          "match": "\\b(void|bool|int[234]?|float[234]?|float[234]x[234]|quaternion|Entity|LocalEntity|PlayerID|Color|Rect|string|Block)\\b"
        },
        {
          "comment": "Built-in singletons, components, records and function groups",
          "name": "support.class.tide",
          "match": "\\b(Time|Math|Draw|GUI|GUILayout|Screen|Anchor|Owner|Devices|Spawned|Destroyed|PlayerJoined|PlayerLeft|Scene|SceneVisibility|Session|SessionState|DisconnectReason|Connected|Disconnected)\\b"
        },
        {
          "comment": "Spawn(...), Send(...)",
          "name": "support.function.tide",
          "match": "\\b(Spawn|Send)(?=\\s*\\()"
        },
        {
          "comment": "e.Add(...), e.Remove(...), e.Destroy(), e.Send(...)",
          "match": "(\\.)\\s*(Add|Remove|Destroy|Send)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.tide" },
            "2": { "name": "support.function.tide" }
          }
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.tide" }
          }
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "comment": "trs.position",
          "match": "(\\.)\\s*([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.tide" },
            "2": { "name": "variable.other.member.tide" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "comment": "Types are PascalCase by convention: Transform, Player",
          "name": "entity.name.type.tide",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.tide",
          "match": "<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^="
        },
        {
          "name": "keyword.operator.logical.tide",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.bitwise.shift.tide",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.comparison.tide",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.bitwise.tide",
          "match": "&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.assignment.tide",
          "match": "="
        },
        {
          "name": "keyword.operator.ternary.tide",
          "match": "\\?|:"
        },
        {
          "name": "keyword.operator.arithmetic.tide",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    }
  }
}
