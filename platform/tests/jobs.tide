// A busy match for running ticks on threads: systems that split their
// entities across threads and others alongside them, changes and events
// recorded on many threads, spawns on one thread and on many, and text read
// while other text changes.

component Body
{
    float3 position;
    float3 velocity;
    int id;
}

component Rock { }

component Ship { }

component Label
{
    string text;
}

component Size
{
    int letters;
}

component Name
{
    string value;
}

// Heavy work for each rock, so ticks are worth threads everywhere: the web
// starts them past more work than desktop does
component Wheel
{
    float angle;
}

component Fuse
{
    int left;
}

// Spawned on many threads: what each knows of the others
component Debris
{
    Entity from;
}

component Shard
{
    Entity of;
    bool debris;
}

struct Link
{
    Entity target;
    int n;
}

component Trail
{
    Entity last;
    Link link;
    int count;
}

singleton Stats
{
    int spawned;
    int hits;
    int chipped;
    int matched;
    int wobbled;
}

event Hit
{
    int damage;
}

event Chipped
{
    Entity ship;
    Entity piece;
}

scene Main { }

event(Spawned) Setup(with Main)
{
    for (var i = 0; i < 12000; i++)
    {
        Spawn(Body { position = float3(float(i), 0, 0), velocity = float3(1, float(i % 7), 0), id = i }, Rock,
              Label { text = $"rock {i}" }, Size, Wheel { angle = float(i) });
    }
    for (var i = 0; i < 6000; i++)
    {
        Spawn(Body { id = i }, Ship, Name { value = $"ship {i}" }, Trail);
    }
}

// Split across threads, a chunk of rocks or ships each
system Move(Time time, mut Body body)
{
    body.position += body.velocity * time.dt;
    if (body.position.y > 50)
        body.velocity.y = -body.velocity.y;
}

system Turn(Time time, mut Wheel wheel)
{
    for (var i = 0; i < 8; i++)
        wheel.angle = Math.Sin(wheel.angle + time.dt * float(i)) * 3;
}

// Changes recorded on every thread: some rocks get a fuse
system Light(Time time, Body body, with Rock, without Fuse)
{
    if ((body.id + time.tick) % 97 == 0)
        this.Add(Fuse { left = body.id % 5 });
}

// ...and fuses that go off, with an event and a Destroy
system Burn(mut Fuse fuse, Body body)
{
    fuse.left -= 1;
    if (fuse.left < 0)
    {
        this.Send(Hit { damage = body.id % 3 + 1 });
        this.Destroy();
    }
}

event(Hit hit) Count(mut Stats stats)
{
    stats.hits += hit.damage;
}

// Spawns split across threads: their entities get IDs once it's done
system Crumble(Time time, Body body, with Rock)
{
    if ((body.id + time.tick) % 500 == 0)
        Spawn(Shard { of = this });
}

// Spawns: on one thread, in order
system Launch(Time time, mut Stats stats)
{
    if (time.tick % 3 == 0)
    {
        Spawn(Body { id = 100000 + stats.spawned, velocity = float3(0, 1, 0) }, Rock, Label { text = "new" }, Size);
        stats.spawned += 1;
    }
}

// ...and split again, with the new entities' handles kept in its own data,
// in the changes it records and in its events, each one theirs once it's done
system Chip(Time time, Body body, mut Trail trail, with Ship)
{
    if ((body.id + time.tick) % 40 == 0)
    {
        var piece = Spawn(Body { id = 200000 + body.id }, Debris { from = this });
        Spawn(Shard { of = piece, debris = true });
        trail.last = piece;
        trail.link.target = piece;
        trail.count += 1;
        piece.Add(Size { letters = 1 });
        piece.Send(Chipped { ship = this, piece = piece });
    }
}

event(Chipped chipped) Seen(mut Stats stats)
{
    stats.chipped += 1;
}

event(Chipped chipped) Matched(Debris debris, mut Stats stats)
{
    if (debris.from == chipped.ship && this == chipped.piece)
        stats.matched += 1;
}

// Text changing in the ships' names...
system Rename(mut Name name, Body body)
{
    if (body.id % 50 == 0)
        name.value = $"ship {body.id} at {int(body.position.x)}";
}

// ...while the rocks' labels are read, on other threads
system Measure(Label label, mut Size size)
{
    size.letters = label.text.Length;
}

// Tasks, started from a system that runs alongside others, many waiting at
// once, which change components and text and spawn as they go on
async void Wobble(mut Wheel wheel, mut Label label, mut Stats stats)
{
    await Wait.Ticks(3);
    wheel.angle += 1;
    label.text = $"{label.text}~";
    stats.wobbled += 1;
    await Wait.Seconds(0.05);
    Spawn(Body { id = 300000 + stats.wobbled }, Rock, Label { text = "wobble" }, Size);
    stats.wobbled += 1;
}

system Wobbly(Time time, mut Wheel wheel, mut Label label, Body body, mut Stats stats)
{
    if ((body.id + time.tick) % 300 == 0) Wobble(wheel, label, stats);
}

// Sand in a grid, its blocks stepped at once on threads (a parallel loop):
// the same, cell for cell, as on one thread
singleton Sandbox
{
    Grid2<int> cells = Grid2(512, 512);
    int poured;
}

// Poured a little each tick, on one thread
system Pour(Time time, mut Sandbox sand)
{
    for (var i = 0; i < 40; i++)
    {
        var x = (time.tick * 37 + i * 101) % 512;
        sand.cells[x, 500 - i % 3] = 1;
    }
    sand.poured += 40;
}

// In 2x2 blocks, whose corners are on even cells one tick and odd ones the
// next: a grain falls into the empty cell below it, or else slides down to
// the other one
system Fall(Time time, mut Sandbox sand)
{
    parallel (var at in sand.cells by 2 offset time.tick % 2)
    {
        mut var a = sand.cells[at + int2(0, 1)];
        mut var b = sand.cells[at + int2(1, 1)];
        mut var c = sand.cells[at];
        mut var d = sand.cells[at + int2(1, 0)];
        if (a == 1 && c == 0)
        {
            a = 0;
            c = 1;
        }
        if (b == 1 && d == 0)
        {
            b = 0;
            d = 1;
        }
        if (a == 1 && d == 0)
        {
            a = 0;
            d = 1;
        }
        if (b == 1 && c == 0)
        {
            b = 0;
            c = 1;
        }
        sand.cells[at] = c;
        sand.cells[at + int2(1, 0)] = d;
        sand.cells[at + int2(0, 1)] = a;
        sand.cells[at + int2(1, 1)] = b;
    }
}

// Heat that spreads to the cells beside it, never across corners: each cell
// gives 4 away while it has that much, and takes 1 from each neighbor that
// does, every cell at once
singleton Heat
{
    Grid2<int> cells = Grid2(256, 256);
}

system Warm(Time time, mut Heat heat)
{
    heat.cells[(time.tick * 13) % 256, (time.tick * 7) % 256] = 100;
}

system Spread(mut Heat heat)
{
    parallel (var at in heat.cells)
    {
        var h = heat.cells[at];
        mut var next = h >= 4 ? h - 4 : h;
        if (heat.cells[at + int2(-1, 0)] >= 4) next += 1;
        if (heat.cells[at + int2(1, 0)] >= 4) next += 1;
        if (heat.cells[at + int2(0, -1)] >= 4) next += 1;
        if (heat.cells[at + int2(0, 1)] >= 4) next += 1;
        heat.cells[at] = next;
    }
}

// Bodies in a list, each pulled toward its neighbors in the list as they
// were, every body at once; then pairs of them, from even ones one tick and
// odd ones the next, trade places when they're out of order
singleton Swarm
{
    List<float3> bodies;
    bool ready;
}

system Gather(mut Swarm swarm)
{
    if (!swarm.ready)
    {
        swarm.ready = true;
        for (var i = 0; i < 6000; i++) swarm.bodies.Add(float3(float(i * 37 % 1000), float(i % 13), 0));
    }
    var n = swarm.bodies.Count;
    parallel (var i in swarm.bodies)
    {
        var near = swarm.bodies[(i + 1) % n] + swarm.bodies[(i + n - 1) % n];
        swarm.bodies[i] = swarm.bodies[i] + (near * 0.5 - swarm.bodies[i]) * 0.1;
    }
}

system Order(Time time, mut Swarm swarm)
{
    parallel (var i in swarm.bodies by 2 offset time.tick % 2)
    {
        var a = swarm.bodies[i];
        var b = swarm.bodies[i + 1];
        if (b.x < a.x)
        {
            swarm.bodies[i] = b;
            swarm.bodies[i + 1] = a;
        }
    }
}
