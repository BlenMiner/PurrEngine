// A game whose data layout tidec describes (tide run's builds do), for
// platform/tests/migrate.c.

enum Mode { Idle, Run = 5, Jump }

struct Stats
{
    int level = 2;
    float speed = 1.5;
}

component Unit
{
    float2 position;
    Mode mode = Mode.Run;
    Stats stats;
    string name = "unit";
    Entity target;
}

component Marker { }

singleton Score
{
    int points = 10;
}

input Controls
{
    float2 move;
}

scene Main { }

scene Arena
{
    int size = 4;
}

event(Spawned) Setup(with Main)
{
    Spawn(Unit { position = float2(1, 2), name = "first" });
    Spawn(Unit { stats = Stats { level = 7 } }, Marker { });
}

// Tasks waiting in the match and in the local world as the game carries over
async event(Spawned) Wander(mut Unit unit)
{
    var label = $"{unit.name}!";
    await Wait.Ticks(30);
    unit.position.x += 1;
    unit.name = label;
}

local singleton Menu
{
    int shown;
    bool started;
}

async void Blink(mut Menu menu)
{
    await Wait.Frames(10);
    menu.shown += 1;
}

view Show(mut Menu menu)
{
    if (menu.started) return;
    menu.started = true;
    Blink(menu);
}
