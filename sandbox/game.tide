namespace Test;

component Transform
{
    float3 position;
}

component Player
{
    float3 velocity;
    float radius = 25;
}

singleton Physics
{
    int collisionCount = 69;
}

input PlayerInput
{
    float horizontal;

    Sample()
    {
        float a = Devices.keyboard.a.pressed ? -1 : 0;
        float d = Devices.keyboard.d.pressed ?  1 : 0;
        horizontal = a + d;
    }

    Sanitize()
    {
        horizontal = Math.Clamp(horizontal, -1, 1);
    }
}

view Map()
{
    float WIDTH = 200;
    Draw.Line(float2(-WIDTH, 0), float2(WIDTH, 0), Color.green);
}

view Test(Transform trs, Player player)
{
    Draw.Circle(trs.position.xy, player.radius, Color.red);
}

system PlayerMovement(mut Transform trs, Player player, Time time)
{
    trs.position += player.velocity * time.dt;
}

[After(PlayerMovement)]
system PlayerClamp(mut Transform trs, mut Player player)
{
    if (trs.position.y <= player.radius)
    {
        player.velocity.y = -player.velocity.y;
        trs.position.y = player.radius;
    }
}

system PlayerGravity(mut Player player, Time time)
{
    player.velocity -= float3(0, 9.7 * time.dt, 0);
}

scene Main { }

event(Spawned) Setup(with Main)
{
    Spawn(
        Transform { position = float3(0, 100, 2) },
        Player { velocity = float3(0, -10, 0) }
    );
}
