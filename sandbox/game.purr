namespace Test;

component Transform
{
    float3 position;
}

component Player
{
    float3 velocity;
}

singleton Physics
{
    int collisionCount = 69;
}

view Test(Transform trs, with Player)
{
    Draw.Circle(trs.position.xy, 5f, Color.red);
}

system PlayerMovement(mut Transform trs, Player player, Time time, mut Physics physics)
{
    trs.position += player.velocity * time.dt;
}

[After(PlayerMovement)]
system PlayerClamp(mut Transform trs, with Player)
{
    if (trs.position.y < 0)
        trs.position.y = 0;
}

system Main()
{
    Spawn(
        Transform { position = float3(0, 100, 2) },
        Player { velocity = float3(0, -10, 0) }
    );
}
