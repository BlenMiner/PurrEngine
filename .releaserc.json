{
  "branches": [
    "release",
    { "name": "dev", "prerelease": "nightly" }
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "parserOpts": {
          "headerPattern": "^(\\w*)(?:\\((.*)\\))?!?: (.*)$",
          "breakingHeaderPattern": "^(\\w*)(?:\\((.*)\\))?!: (.*)$"
        },
        "releaseRules": [{ "breaking": true, "release": "minor" }]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "angular",
        "parserOpts": {
          "headerPattern": "^(\\w*)(?:\\((.*)\\))?!?: (.*)$",
          "breakingHeaderPattern": "^(\\w*)(?:\\((.*)\\))?!: (.*)$"
        }
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "if [ \"${branch.name}\" = \"release\" ]; then echo ${nextRelease.version} > VERSION; fi"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["VERSION"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "dist/tide-windows-x64.zip", "label": "tide for Windows (x64)" },
          { "path": "dist/tide-linux-x64.tar.gz", "label": "tide for Linux (x64)" },
          { "path": "dist/tide-macos-arm64.tar.gz", "label": "tide for macOS (Apple Silicon)" },
          { "path": "dist/tide-jetbrains.zip", "label": "Tide plugin for JetBrains IDEs" },
          { "path": "dist/SHA256SUMS", "label": "SHA256SUMS" }
        ],
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
